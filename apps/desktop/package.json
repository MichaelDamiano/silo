{
  "name": "@silo/desktop",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && vite build",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "build:deps": "npm run build -w @silo/protocol -w @silo/signal",
    "dev": "npm run build:deps && npm run build && electron .",
    "start": "electron .",
    "test": "vitest run",
    "dist": "npm run build:deps && npm run build && electron-builder --publish never",
    "verify-release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@silo/protocol": "0.1.0",
    "@silo/signal": "0.1.0",
    "socks": "^2.8.10",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.1",
    "@electron/fuses": "^2.1.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "description": "Silo desktop client",
  "author": "Silo contributors"
}
